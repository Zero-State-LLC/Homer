{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // homer-intake: every route a machine pushes to (ADR 013). It holds no read
  // or admin audience and serves no page.
  "name": "homer-intake",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // The Worker version id and upload tag (versioning spec, "Worker version").
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "durable_objects": {
    "bindings": [
      // Defined here: nothing else reads job evidence.
      { "name": "JOB_EVIDENCE", "class_name": "WorkflowJobEvidenceObject" },
      // homer-catalog's namespaces. Bindings point one way, from intake to the
      // catalog, so deploy the catalog first. An environment whose catalog
      // Worker has another name sets script_name to that name.
      {
        "name": "MAPPING_CATALOG",
        "class_name": "MappingCatalogObject",
        "script_name": "homer-catalog",
      },
      { "name": "RUNNER_FLEET", "class_name": "RunnerFleetObject", "script_name": "homer-catalog" },
    ],
  },
  "migrations": [{ "tag": "job-evidence-v1", "new_sqlite_classes": ["WorkflowJobEvidenceObject"] }],
}
