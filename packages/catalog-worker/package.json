{
  "name": "@zs-home/catalog-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./access": {
      "types": "./dist/access.d.ts",
      "default": "./dist/access.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./machine": {
      "types": "./dist/machine.d.ts",
      "default": "./dist/machine.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/bindings.d.ts', 'dist/bindings.d.ts')\""
  },
  "dependencies": {
    "@zs-home/github-sync": "0.0.0",
    "jose": "6.2.18",
    "@zs-home/event-ledger": "0.0.0",
    "@zs-home/projections": "0.0.0"
  }
}
