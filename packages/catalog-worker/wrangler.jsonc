{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "homer-catalog",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // The Worker version id and upload tag (versioning spec, "Worker version").
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "durable_objects": {
    "bindings": [
      { "name": "RUNNER_FLEET", "class_name": "RunnerFleetObject" },
      { "name": "MAPPING_CATALOG", "class_name": "MappingCatalogObject" },
      { "name": "BUZZ_CHANNELS", "class_name": "BuzzChannelCatalogObject" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MappingCatalogObject"] },
    { "tag": "runner-v1", "new_sqlite_classes": ["RunnerFleetObject"] },
    { "tag": "v2", "new_sqlite_classes": ["BuzzChannelCatalogObject"] },
  ],
}
