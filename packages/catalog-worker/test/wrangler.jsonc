{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "homer-catalog-test",
  "main": "worker.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      { "name": "MAPPING_CATALOG", "class_name": "MappingCatalogObject" },
      { "name": "EVENT_LEDGER", "class_name": "EventLedgerObject" },
      { "name": "BUZZ_CHANNELS", "class_name": "BuzzChannelCatalogObject" },
    ],
  },
  "migrations": [
    { "tag": "test-v1", "new_sqlite_classes": ["MappingCatalogObject", "EventLedgerObject"] },
    { "tag": "test-v2", "new_sqlite_classes": ["BuzzChannelCatalogObject"] },
  ],
}
