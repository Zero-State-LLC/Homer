{
  "name": "home",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @zs-home/shared-contracts && npm run build -w @zs-home/event-ledger && npm run build -w @zs-home/projections",
    "postbuild": "node --test scripts/*runtime.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run build && npm run format:check && npm run lint && npm run typecheck && npm test && npm run smoke:workers",
    "pretypecheck": "npm run build",
    "pretest": "npm run build",
    "smoke:workers": "node scripts/ledger-smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.5",
    "@cloudflare/workers-types": "5.20261119.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
